---
interface Props {
  rows: { name: string; note: string }[];
}

const { rows } = Astro.props;
---

<div
  class="mt-10 flex flex-col border-t-2 border-ink lg:mt-0 lg:rounded-card lg:border lg:border-line lg:bg-surface lg:px-7 lg:pt-2 lg:pb-3 lg:shadow-card"
>
  <div
    class="flex items-baseline justify-between pt-3.5 pb-2.5 lg:border-b-2 lg:border-ink lg:pt-4.5 lg:pb-3.5"
  >
    <div class="font-serif text-22 lg:text-26">Контакты</div>
    <div class="text-13 font-medium text-accent lg:text-sm">Добавить контакт</div>
  </div>
  <div
    class="mb-1.5 flex h-10 items-center rounded-control border border-line-input bg-field px-3 text-13 text-placeholder lg:mt-4 lg:h-11 lg:bg-input lg:px-3.5 lg:text-sm"
  >
    Поиск по имени
  </div>
  <ul>
    {
      rows.map((row) => (
        <li class="flex flex-col gap-0.5 border-b border-line py-3 last:border-b-0 lg:flex-row lg:items-baseline lg:justify-between lg:gap-4 lg:border-line-soft lg:py-3.5">
          <span class="font-serif text-17 lg:text-lg">{row.name}</span>
          <span class="text-13 text-subtle lg:text-sm">{row.note}</span>
        </li>
      ))
    }
  </ul>
</div>
